# Copy this file to .env for local development and fill in your own values.
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only if your database provider requires SSL from this app.
PGSSL=false

# Admin shared secret: generate a long random value; never commit the real value.
ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=

# Cloudflare R2 (create a private bucket and bucket-scoped API token)
R2_ACCOUNT_ID=
# Optional: eu only when your R2 bucket uses the EU jurisdiction endpoint; otherwise leave blank.
R2_JURISDICTION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe (use test keys while testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Preferred for Render Free: API-based email sending, no SMTP port required.
# Verify your sending domain with Resend before using your own MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=Épure Auto <notifications@example.com>

# Optional SMTP fallback for hosts that permit outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
